{
  "name": "structura-solver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone 2D truss, beam and frame analysis with detailed calculations.",

  "engines": {
    "node": ">=22.13.0"
  },

  "packageManager": "pnpm@11.25.0",

  "scripts": {
    "dev": "vite",
    "start": "node scripts/serve.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/solver.test.mjs",
    "check:static": "node scripts/check-static.mjs"
  },

  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },

  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}